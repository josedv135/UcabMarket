# Configuración del Servidor NestJS
PORT=3000
NODE_ENV=development

# Configuración de CORS para el Frontend
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:8080

# Autenticación y Seguridad
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# Almacenamiento Local de Archivos
UPLOAD_DEST=./uploads
MAX_PRODUCT_IMAGES=5
MAX_FILE_SIZE_BYTES=5242880 # 5 MB por archivo
